# Скопируй этот файл в .env для локального запуска (для Render значения вводятся
# в её собственной панели Environment — реальный .env туда не заливается никогда).

PORT=3000

# --- Логин/пароль, которые ты пропишешь В 1С в узле обмена ---
# Это НОВЫЕ значения, придуманные для нашей прокладки, не обязательно совпадают со старыми.
AUTH_USER=bridge
AUTH_PASS=придумай-длинный-случайный-пароль

# --- Настоящие данные Тильды (со скрина "Синхронизация через CommerceML") ---
# Нужны, чтобы прокладка сама могла сходить к настоящей Тильде за каталогом и заказами.
TILDA_USER=27122996
TILDA_PASS=a1748e42bbaf19430e76d55343232549
